# SiliconFlow MCP 服务配置
# 获取 API Key: https://console.siliconflow.cn/

# SiliconFlow API 配置
MCP_SERVICE_URL=https://api.siliconflow.cn/v1
MCP_API_KEY=your_siliconflow_api_key_here

# 模型配置
MCP_DEFAULT_MODEL=Qwen/QwQ-32B
MCP_MAX_TOKENS=4000
MCP_TEMPERATURE=0.7
MCP_TOP_P=0.9

# 超时和重试配置
MCP_TIMEOUT=60
MCP_MAX_RETRIES=3
MCP_RETRY_DELAY=1

# 缓存配置
MCP_CACHE_ENABLED=true
MCP_CACHE_TTL=300

# 健康检查配置
MCP_HEALTH_CHECK_ENABLED=true
MCP_HEALTH_CHECK_INTERVAL=60

# 日志配置
MCP_LOG_LEVEL=INFO
MCP_LOG_REQUESTS=true

# ========== 美股数据源 API Keys ==========
# Finnhub: https://finnhub.io/ (部分功能无需key)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage: https://www.alphavantage.co/ (免费25次/天)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
